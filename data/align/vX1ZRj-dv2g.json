{"model":"YunusZJ/whisper-base-ar-quran-ONNX","texts":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"يَا أَيُّهَا الَّذِينَ آمَنُوا اجْتَنِبُوا كَثِيرًا مِنَ الظَّنِّ",null,null,"أَيُحِبُّ أَحَدُكُمْ أَنْ يَأْكُلَ لَحْمَ أَخِيهِ مَيْتًا فَكَرِهْتُمُونَ","وَالْمُؤْمِنِينَ","وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ تَوَّابٌ رَحِيمٌ","يَا أَيُّهَا النَّاسُ إِنَّا خَلَقْنَاكُمْ","إِنَّا خَلَقْنَاكُمْ مِنْ ذَكَرٍ وَأُنْثَى وَجَعَلْنَاكُمْ","وَجَعَلْنَاكُمْ شُعُوبًا وَقَبَائِلَ لِتَعَارُكُمْ","إِنَّ أَكْرَمَكُمْ عِنْدَ اللَّهِ أَتْقَاكُمْ","إِنَّ اللَّهَ عَلِيمٌ خَيْرٌ","قَالَتِ الْأَعْرَارُ آمَنَّا","قُلْ لَمْ تُؤْمِنُوا وَلَكِنْ قُولُوا",null,null,null,null,null,"أُولَئِكَ هُمُ الصَّادِقُونَ",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"قَدْ عَلِمْنَا مَا تَنْقُصُ الْأَرْضُ مِنْهُمْ وَعِنْدَنَا كِتَابٌ حَفِيظٌ",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,"يَسْأَلُونَ أَيَّانَ يَوْمُ الدِّينِ"],"done":true}